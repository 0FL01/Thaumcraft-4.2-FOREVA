{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    // Currently accepted but has no V2 runtime effect; keep false for portability.
    "prune": false,
    // Retain enough immediate context to finish/reconcile a small checkpoint.
    "keep": {
      "tokens": 12000
    },
    // Start Compact early enough to fit the summary call and its output.
    "buffer": 32000
  }
}
