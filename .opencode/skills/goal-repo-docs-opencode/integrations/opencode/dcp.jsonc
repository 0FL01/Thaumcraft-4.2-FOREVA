{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "pruneNotification": "minimal",
  "pruneNotificationType": "toast",
  "turnProtection": {
    "enabled": true,
    "turns": 6
  },
  "experimental": {
    // Safe only because every audit shard writes a progressive durable report.
    "allowSubAgents": true,
    "customPrompts": false
  },
  "protectedFilePatterns": [
    "**/.opencode/active-goal",
    "**/docs/goals/**/GOAL.md",
    "**/docs/goals/**/RECON.md",
    "**/docs/goals/**/SOURCES.md",
    "**/docs/goals/**/STATE.md",
    "**/docs/goals/**/LOG.md",
    "**/docs/goals/**/reports/*.md",
    "**/docs/goals/**/sources/**",
    "**/docs/goals/**/evidence/**"
  ],
  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": false,
    "summaryBuffer": true,
    // Conservative starting point for long-horizon coding. Tune per model/provider.
    "minContextLimit": "45%",
    "maxContextLimit": "70%",
    "nudgeFrequency": 2,
    "iterationNudgeThreshold": 10,
    "nudgeForce": "strong",
    "protectedTools": ["task", "skill", "todowrite", "todoread"],
    "protectTags": true,
    // Exact user constraints must already be registered in SOURCES/RECON.
    // Keeping giant pasted prompts forever defeats pruning.
    "protectUserMessages": false
  }
}
